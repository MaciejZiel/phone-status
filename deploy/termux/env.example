# Copy to deploy/termux/env and adjust. All values are optional.
PHONE_STATUS_HOST=127.0.0.1
PHONE_STATUS_PORT=8090
# Public URL prefix when nginx serves the page below a path (empty = at the root)
PHONE_STATUS_BASE_PATH=/status
PHONE_STATUS_TITLE="Home server status"
PHONE_STATUS_CHECK_INTERVAL=45
PHONE_STATUS_HOST_INTERVAL=15
PHONE_STATUS_RETENTION_DAYS=8
# Directory whose filesystem is reported as "Storage"
PHONE_STATUS_STORAGE_PATH=~
# PHONE_STATUS_SERVICES_FILE=/data/data/com.termux/files/home/phone-status/services.toml
# PHONE_STATUS_DB_PATH=/data/data/com.termux/files/home/phone-status/data/status.sqlite
