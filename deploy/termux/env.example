# Copy to deploy/termux/env and adjust. All values are optional.
SERVER_STATUS_HOST=127.0.0.1
SERVER_STATUS_PORT=8090
# Public URL prefix when nginx serves the page below a path (empty = at the root)
SERVER_STATUS_BASE_PATH=/status
SERVER_STATUS_TITLE="Home server status"
SERVER_STATUS_CHECK_INTERVAL=45
SERVER_STATUS_HOST_INTERVAL=15
SERVER_STATUS_RETENTION_DAYS=8
# Directory whose filesystem is reported as "Storage"
SERVER_STATUS_STORAGE_PATH=~
# SERVER_STATUS_SERVICES_FILE=/data/data/com.termux/files/home/server-status/services.toml
# SERVER_STATUS_DB_PATH=/data/data/com.termux/files/home/server-status/data/status.sqlite
